{
  "name": "latex-workbench",
  "version": "0.11.1",
  "private": true,
  "description": "Windows-first local LaTeX project manager",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "vite preview --config vite.web.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "package:portable": "pnpm build && electron-builder --win portable --publish never",
    "package:windows": "pnpm build && electron-builder --win nsis portable --publish never",
    "package:windows:beta": "pnpm build && electron-builder --config electron-builder.beta.cjs --win nsis portable --publish never",
    "release:keygen": "node scripts/generate-release-signing-key.mjs",
    "release:manifest": "node scripts/sign-release-manifest.mjs"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "diff": "9.0.0",
    "latex-utensils": "7.0.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@playwright/test": "1.61.1",
    "@types/diff": "8.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "config": {
    "betaVersion": "1.0.0-beta.3"
  },
  "build": {
    "appId": "local.latex.workbench",
    "productName": "LaTeX 项目管理器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "packageManager": "pnpm@11.9.0"
}
